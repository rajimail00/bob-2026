NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://127.0.0.1:27017/bob_dev

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CORS_ORIGIN=http://localhost:8081

# SMTP — verification emails. In development, leave unset to log codes to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="BOB <no-reply@bob-app.com>"

# Cloudinary — job photo/video and profile photo storage. Leave unset to disable media uploads.
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
